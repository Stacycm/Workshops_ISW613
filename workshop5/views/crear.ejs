
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registrar libro - Workshop5</title>
    <link rel="stylesheet" href="/estilos.css">
</head>
<body>

    <div class="contenedor">

        <h1>Registrar nuevo libro</h1>

        <p>Completa los siguientes campos para registrar un libro.</p>

        <form action="/libros" method="POST">

            <div class="campo">
                <label for="titulo">Título:</label>
                <input
                    type="text"
                    id="titulo"
                    name="titulo"
                    placeholder="Nombre del libro"
                    required
                >
            </div>

            <div class="campo">
                <label for="autor">Autor:</label>
                <input
                    type="text"
                    id="autor"
                    name="autor"
                    placeholder="Nombre del autor"
                    required
                >
            </div>

            <div class="campo">
                <label for="genero">Género:</label>
                <input
                    type="text"
                    id="genero"
                    name="genero"
                    placeholder="Género literario"
                    required
                >
            </div>

            <div class="campo">
                <label for="anio_publicacion">Año de publicación:</label>
                <input
                    type="number"
                    id="anio_publicacion"
                    name="anio_publicacion"
                    placeholder="Ejemplo: 2020"
                    required
                >
            </div>

            <button type="submit" class="btn btn-guardar">
                Guardar libro
            </button>

        </form>

        <a href="/libros" class="volver">
            ← Volver a la lista
        </a>

    </div>

</body>
</html>
